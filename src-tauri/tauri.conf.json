{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Instrumentum Urbis",
  "version": "1.0.0",
  "identifier": "io.github.jayxpab.instrumentumurbis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Instrumentum Urbis",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jay",
    "category": "Utility",
    "shortDescription": "Bulk generator of unique Minecraft building facades",
    "longDescription": "Draw Minecraft building facades stage by stage and export thousands of unique buildings as .schem, .bp and .litematic files.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Instrumentum Urbis"
      }
    }
  }
}
